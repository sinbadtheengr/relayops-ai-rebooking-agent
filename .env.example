# One process, workspace and dedicated persistent directory per client.
RELAYOPS_CLIENT_ID=
RELAYOPS_DATA_DIR=./data/pilot
TIMEZONE=America/Toronto

# Legal/business identity for the spa sending on its own behalf.
RELAYOPS_SENDER_NAME=
RELAYOPS_MAILING_ADDRESS=
RELAYOPS_CONTACT_EMAIL=

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
RELAYOPS_STAFF_IDS=

# Optional aggregate reports to the existing staff channel.
SLACK_REPORT_CHANNEL_ID=
DAILY_SCAN_ENABLED=false
DAILY_SCAN_CRON=0 8 * * 1-6

# Existing optional AI Q&A. Local templates work offline.
RELAYOPS_ENABLE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
